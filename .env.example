# ==============================================================================
# SentinelOps — Platform Environment Configuration
# Tagline: "Observe. Detect. Investigate. Resolve."
# ==============================================================================

# Core Application Settings
PROJECT_NAME=SentinelOps
TAGLINE="Observe. Detect. Investigate. Resolve."
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_STR=/api/v1

# CORS Origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# PostgreSQL 17 Configuration
# In Docker Compose, the server hostname is 'postgres'. For local standalone development, use 'localhost'.
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_secret_change_me
POSTGRES_DB=sentinelops_db

# Optional direct connection override (leave commented to use individual variables)
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_secret_change_me@postgres:5432/sentinelops_db

# SQLAlchemy Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_PRE_PING=true

# Health Probe Configuration
HEALTH_TIMEOUT_SECONDS=3.0

# Prometheus & Windows Exporter Telemetry (Phase 2)
# In Docker Compose, the server hostname is 'http://prometheus:9090'. For local standalone backend, use 'http://127.0.0.1:9090'.
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_TIMEOUT_SECONDS=5.0
WINDOWS_EXPORTER_PORT=9182

# Monitoring Health Thresholds
CPU_WARNING_THRESHOLD=75.0
CPU_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=80.0
MEMORY_CRITICAL_THRESHOLD=92.0
DISK_WARNING_THRESHOLD=85.0
DISK_CRITICAL_THRESHOLD=95.0

# Frontend Configuration
VITE_API_URL=/api/v1

